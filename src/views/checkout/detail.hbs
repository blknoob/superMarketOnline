{{!-- filepath: c:\Desarrollador\backend-2\entrega.final\src\views\orders\detail.hbs --}}
<h2>Detalle de la Orden</h2>
<p><strong>ID:</strong> {{order._id}}</p>
<p><strong>Estado:</strong> {{order.status}}</p>
<p><strong>Fecha:</strong> {{order.createdAt}}</p>

<h3>Productos:</h3>
<table>
  <thead>
    <tr>
      <th>Producto</th>
      <th>Cantidad</th>
      <th>Precio</th>
      <th>Subtotal</th>
    </tr>
  </thead>
  <tbody>
    {{#each order.items}}
      <tr>
        <td>{{this.name}}</td>
        <td>{{this.qty}}</td>
        <td>{{this.price}}</td>
        <td>{{this.subtotal}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>

<p><strong>Total:</strong> {{order.total}} {{order.currency}}</p>

{{#if order.paymentIntent}}
  <h3>Pago</h3>
  <p><strong>Método:</strong> {{order.paymentIntent.method}}</p>
  <p><strong>Referencia:</strong> {{order.paymentIntent.reference}}</p>
  <p><strong>Estado del pago:</strong> {{order.paymentIntent.status}}</p>
  {{#if order.paymentIntent.customerProof}}
    <p><strong>Comprobante:</strong></p>
    <img src="{{order.paymentIntent.customerProof}}" alt="Comprobante" style="max-width:300px;">
  {{/if}}
{{else}}
  <p><em>No hay información de pago registrada aún.</em></p>
{{/if}}