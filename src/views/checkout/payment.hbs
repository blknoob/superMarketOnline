{{! layout main }}
<h2>Pago de tu orden</h2>
<p>Orden: {{order._id}}</p>
<p>Total a pagar: <strong>{{order.total}} {{order.currency}}</strong></p>

<h3>Selecciona tu método de pago:</h3>

<form action="/api/payments/pagomovil/{{order._id}}" method="POST" enctype="multipart/form-data">
  <h4>PAGO MÓVIL</h4>
  <label>Banco:</label>
  <input name="bank" required>
  <label>Teléfono:</label>
  <input name="phone" required>
  <label>Cédula/RIF:</label>
  <input name="docId" required>
  <label>Referencia:</label>
  <input name="reference" required>
  <label>Monto:</label>
  <input name="amount" value="{{order.total}}" required>
  <label>Comprobante:</label>
  <input type="file" name="proof" accept="image/*,application/pdf" required>
  <button type="submit">Reportar Pago Móvil</button>
</form>

<form action="/api/payments/zelle/{{order._id}}" method="POST">
  <h4>ZELLE</h4>
  <label>Email Zelle:</label>
  <input name="email" required>
  <label>Referencia:</label>
  <input name="reference" required>
  <label>Monto:</label>
  <input name="amount" value="{{order.total}}" required>
  <button type="submit">Reportar Zelle</button>
</form>
