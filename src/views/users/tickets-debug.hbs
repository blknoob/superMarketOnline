<h2>DEBUG: Mis Compras</h2>

<p>Tickets totales: {{tickets.length}}</p>

{{#each tickets}}
<div style="border: 1px solid #ccc; margin: 10px 0; padding: 10px;">
  <h3>{{this.code}}</h3>
  <p>Total: ${{this.amount}}</p>
  <p>Productos: {{this.products.length}}</p>
  
  {{#each this.products}}
  <div style="border-left: 3px solid #007bff; padding-left: 10px; margin: 5px 0;">
    <p><strong>{{this.product.title}}</strong></p>
    <p>Cantidad: {{this.quantity}} | Precio: ${{this.price}}</p>
  </div>
  {{/each}}
</div>
{{/each}}