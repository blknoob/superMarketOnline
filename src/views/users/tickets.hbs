<h2>Mis Compras</h2>

{{#if tickets.length}}
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    {{#each tickets}}
      <details style="border: 1px solid #ddd; border-radius: 8px; padding: 1.5rem; background-color: #f9f9f9; margin-bottom: 1.5rem;">
        <summary style="cursor: pointer; outline: none; list-style: none; margin-bottom: 1rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
              <h3 style="margin: 0; color: #333; display: inline;">
                <span style="margin-right: 10px;">📋</span>
                Ticket: {{this.code}}
              </h3>
              <p style="margin: 0.2rem 0; color: #666; font-size: 0.9rem;">{{formatDate this.createdAt}}</p>
            </div>
            <div style="text-align: right;">
              <p style="margin: 0; font-size: 1.2rem; font-weight: bold; color: #007bff;">${{this.amount}}</p>
              <p style="margin: 0; font-size: 0.9rem; color: #666;">{{this.products.length}} producto{{#if this.products.length}}s{{/if}}</p>
            </div>
          </div>
          <div style="text-align: center; margin-top: 0.5rem; color: #666; font-size: 0.9rem;">
            Click para ver productos ▼
          </div>
        </summary>
        
        {{#if this.products.length}}
          <h4 style="margin-bottom: 0.8rem; color: #555;">Productos comprados:</h4>
          <div style="display: grid; gap: 0.8rem;">
            {{#each this.products}}
              <div style="display: flex; align-items: center; padding: 0.8rem; background-color: white; border-radius: 6px; border: 1px solid #eee;">
                {{#if this.product.image}}
                  <img src="{{this.product.image}}" alt="{{this.product.title}}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px; margin-right: 1rem;">
                {{else}}
                  <div style="width: 50px; height: 50px; background-color: #f0f0f0; border-radius: 4px; margin-right: 1rem; display: flex; align-items: center; justify-content: center; color: #999; font-size: 0.8rem;">Sin imagen</div>
                {{/if}}
                
                <div style="flex-grow: 1;">
                  <h5 style="margin: 0; color: #333;">
                    {{#if this.product.title}}
                      {{this.product.title}}
                    {{else}}
                      <span style="color: #999; font-style: italic;">Producto ya no disponible</span>
                    {{/if}}
                  </h5>
                  {{#if this.product.code}}
                    <p style="margin: 0.2rem 0; color: #666; font-size: 0.85rem;">Código: {{this.product.code}}</p>
                  {{else}}
                    <p style="margin: 0.2rem 0; color: #999; font-size: 0.85rem;">ID: {{../product}}</p>
                  {{/if}}
                </div>
                
                <div style="text-align: right;">
                  <p style="margin: 0; font-weight: bold;">x{{this.quantity}}</p>
                  <p style="margin: 0; color: #666; font-size: 0.9rem;">${{this.price}} c/u</p>
                  <p style="margin: 0; font-weight: bold; color: #007bff;">${{multiply this.price this.quantity}}</p>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <div style="text-align: center; color: #999; padding: 1rem;">
            <p>No se encontraron productos para este ticket</p>
          </div>
        {{/if}}
      </details>
    {{/each}}
  </div>
{{else}}
  <div style="text-align: center; padding: 3rem; color: #666;">
    <h3>No tienes compras realizadas aún</h3>
    <p>Cuando realices tu primera compra, aparecerá aquí con todos los detalles.</p>
    <a href="/" style="display: inline-block; padding: 0.8rem 1.5rem; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px; margin-top: 1rem;">Ir a comprar</a>
  </div>
{{/if}}
