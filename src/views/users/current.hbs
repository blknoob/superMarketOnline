<h2>Mi perfil</h2>
{{> flash}}

<ul>
  <li><strong>Nombre:</strong> {{profile.first_name}} {{profile.last_name}}</li>
  <li><strong>Email:</strong> {{profile.email}}</li>
  {{#if profile.birth_date}}<li><strong>Fecha de nacimiento:</strong> {{formatDate profile.birth_date}}</li>{{/if}}
  <li><strong>Rol:</strong> {{profile.role}}</li>
</ul>

<h3>Mis direcciones</h3>
{{#if addresses.length}}
  <ul>
    {{#each addresses}}
      <li>
        <strong>{{label}}</strong>{{#if isDefault}} (predeterminada){{/if}} — {{recipient}} ({{phone}}):
        {{line1}}{{#if line2}}, {{line2}}{{/if}}, {{city}}, {{state}}
      </li>
    {{/each}}
  </ul>
{{else}}
  <p>No tienes direcciones guardadas.</p>
{{/if}}

<details>
  <summary>Agregar dirección</summary>
  <form action="/current/addresses" method="POST" class="stacked-form">
    <label>Nombre <input name="label" placeholder="Casa, Oficina..."></label>
    <label>Quién recibe <input name="recipient" required></label>
    <label>Teléfono <input name="phone" required></label>
    <label>Dirección <input name="line1" required placeholder="Calle, número, edificio"></label>
    <label>Detalle <input name="line2" placeholder="Piso, apartamento (opcional)"></label>
    <label>Ciudad <input name="city" required></label>
    <label>Estado <input name="state" required></label>
    <label>Punto de referencia <input name="reference" placeholder="(opcional)"></label>
    <button type="submit">Guardar dirección</button>
  </form>
</details>
