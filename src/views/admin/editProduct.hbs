{{> adminNav}}
<p><a href="/admin/products">‹ Productos</a></p>
<h2>Editar: {{product.name}}</h2>
{{> flash}}

{{#if product.image}}<img src="{{product.image}}" alt="{{product.name}}" class="thumb-large">{{/if}}

<form action="/admin/products/{{product._id}}/edit" method="POST" enctype="multipart/form-data" class="grid-form card">
  {{> productFields}}
  <button type="submit">Guardar cambios</button>
</form>
