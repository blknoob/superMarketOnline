{{> adminNav}}
<h2>Productos</h2>
{{> flash}}

<details class="card" {{#unless products.length}}open{{/unless}}>
  <summary><strong>Nuevo producto</strong></summary>
  <form action="/admin/products" method="POST" enctype="multipart/form-data" class="grid-form">
    {{> productFields}}
    <button type="submit">Crear producto</button>
  </form>
</details>

<form action="/admin/products" method="GET" class="search-form">
  <select name="category">
    <option value="">Todas las categorías</option>
    {{#each categories}}
      <option value="{{slug}}" {{#if (eq slug @root.currentCategorySlug)}}selected{{/if}}>{{label}}</option>
    {{/each}}
  </select>
  <input type="search" name="q" value="{{search}}" placeholder="Buscar...">
  <button type="submit">Filtrar</button>
</form>

{{#if products.length}}
  <table class="table">
    <thead>
      <tr>
        <th></th><th>Producto</th><th>SKU</th><th>Categoría</th>
        <th class="num">Ref. €</th><th class="num">Bs</th><th class="num">Stock</th><th>Estado</th><th></th>
      </tr>
    </thead>
    <tbody>
      {{#each products}}
        <tr {{#unless isActive}}class="row-muted"{{/unless}}>
          <td>{{#if image}}<img src="{{image}}" alt="" class="thumb">{{/if}}</td>
          <td>{{name}} <small>{{presentation unitSize unit}}{{#if brand}} · {{brand.name}}{{/if}}</small></td>
          <td>{{sku}}</td>
          <td>{{category.name}}</td>
          <td class="num">{{money priceRef}}</td>
          <td class="num">{{money price}}</td>
          <td class="num">{{stock}}</td>
          <td>{{#if isActive}}Activo{{else}}Inactivo{{/if}}</td>
          <td class="num">
            <a href="/admin/products/{{_id}}/edit">Editar</a>
            <form action="/admin/products/{{_id}}/delete" method="POST" class="inline-form" onsubmit="return confirm('¿Eliminar {{name}}?')">
              <button type="submit" class="btn-small btn-danger">Eliminar</button>
            </form>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
{{else}}
  <p>No hay productos{{#if search}} para "{{search}}"{{/if}}.</p>
{{/if}}
