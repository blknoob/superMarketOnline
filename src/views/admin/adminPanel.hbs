{{> adminNav}}
<h2>Panel de administración</h2>
{{> flash}}

{{#if pendingPaymentsCount}}
  <div class="alert alert-info">
    Hay {{pendingPaymentsCount}} pago(s) por revisar. <a href="/admin/orders?status=payment_review">Ver pedidos</a>
  </div>
{{/if}}

<section class="card">
  <h3>Precios</h3>
  <p>
    Los productos guardan su precio en euros (Ref.). El precio en bolívares se calcula con la tasa de abajo,
    así que al cambiarla todos los precios se actualizan al instante. Los pedidos ya hechos conservan la tasa de su momento.
  </p>
  <form action="/admin/settings" method="POST" class="stacked-form narrow">
    <label>Tasa EUR (Bs por 1 €)
      <input type="number" name="eurRate" step="0.0001" min="0.0001" value="{{rate}}" required>
    </label>
    <label>Costo de envío (Ref. €)
      <input type="number" name="shippingCostRef" step="0.01" min="0" value="{{shippingCostRef}}">
    </label>
    <button type="submit">Guardar</button>
  </form>
  {{#if rateUpdatedAt}}
    <p><small>Última actualización de la tasa: {{formatDate rateUpdatedAt}}</small></p>
  {{else}}
    <p class="text-danger"><small>La tasa todavía no está configurada: la tienda no muestra precios en Bs ni permite comprar.</small></p>
  {{/if}}
</section>
