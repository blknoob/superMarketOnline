{{! Menú de categorías: se arma con el árbol guardado en la base (res.locals.categoryTree) }}
<div class="categories-menu">
  <h3 class="categories-title">Categorías</h3>

  <div class="category-item">
    <a href="/" class="category-link {{#unless @root.currentCategorySlug}}active{{/unless}}">Todos los productos</a>
  </div>

  {{#each @root.categoryTree}}
    <div class="category-item">
      <div class="category-main {{#if (eq slug @root.activeRootSlug)}}active{{/if}}">
        <a href="/?category={{slug}}" class="category-link">{{name}}</a>
        {{#if children.length}}<span class="category-toggle">▼</span>{{/if}}
      </div>
      {{#if children.length}}
        <div class="subcategories {{#if (eq slug @root.activeRootSlug)}}show{{/if}}">
          {{#each children}}
            <a href="/?category={{slug}}" class="subcategory-link {{#if (eq slug @root.currentCategorySlug)}}active{{/if}}">{{name}}</a>
          {{/each}}
        </div>
      {{/if}}
    </div>
  {{/each}}
</div>
