<div class="product-card">
  <div class="product-img-container">
    {{#if image}}
      <img class="product-img" src="{{image}}" alt="{{name}}" />
    {{else}}
      <span class="product-img-placeholder">Sin imagen</span>
    {{/if}}
  </div>
  {{#if brand}}<p class="product-brand">{{brand.name}}</p>{{/if}}
  <h3 class="product-title">{{name}}</h3>
  <p class="product-presentation">{{presentation unitSize unit}}</p>
  {{#if price}}
    <p class="product-price"><strong>Bs {{money price}}</strong></p>
  {{/if}}
  <p class="product-ref">Ref. € {{money priceRef}}</p>
  {{#if stock}}
    <p class="product-stock">Disponibles: {{stock}}</p>
    <form action="/cart/add" method="POST" class="product-form">
      <input type="hidden" name="productId" value="{{_id}}" />
      <button type="submit">Agregar al carrito</button>
    </form>
  {{else}}
    <p class="product-nostock">Sin stock</p>
  {{/if}}
</div>
