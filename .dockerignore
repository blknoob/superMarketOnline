# OWASP - .dockerignore seguro

# Archivos de entorno y secretos
.env
.env.*
!.env.example

# Archivos de desarrollo
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Archivos de Git
.git
.gitignore
.github

# Archivos de editor
.vscode
.idea
*.swp
*.swo
*~

# Archivos de sistema operativo
.DS_Store
Thumbs.db

# Archivos de logs
logs/*.log
*.log

# Archivos temporales
tmp/
temp/
.tmp

# Archivos de prueba
tests/
test/
*.test.js
*.spec.js
jest.config.js
.nyc_output
coverage/
.coverage

# Documentación de desarrollo
README.md
docs/
*.md
!API_DOCUMENTATION.md

# Archivos de build y distribución
dist/
build/

# Archivos de debug
debug-server.js

# Archivos de base de datos local
*.sqlite
*.db

# Archivos de certificados locales
*.pem
*.key
*.crt

# Uploads y archivos subidos localmente
uploads/
public/comprobantes/
public/images/
public/uploads/
!public/images/.gitkeep

# Cache
.cache